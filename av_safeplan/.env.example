# External assets are intentionally kept outside Git.
CARLA_ROOT=/opt/carla/CarlaUE4_0.9.15
SIMLINGO_ROOT=/opt/simlingo
SIMLINGO_CHECKPOINT=/opt/models/simlingo/simlingo/checkpoints/epoch=013.ckpt/pytorch_model.pt
HF_HOME=/opt/models/huggingface

# Set automatically by scripts/setup_colab.sh on Colab.
MAMBA_ROOT_PREFIX=/content/av_safeplan/micromamba
MICROMAMBA_BIN=/content/av_safeplan/bin/micromamba
AV_SAFEPLAN_ENV_NAME=av-safeplan-simlingo
AV_SAFEPLAN_OUTPUT_ROOT=/content/av_safeplan/outputs/trajectories
AV_SAFEPLAN_MAPS_MIN_FREE_GB=20

# Optional connection overrides. Defaults come from config/stack.yaml.
CARLA_HOST=127.0.0.1
CARLA_PORT=2000
CARLA_TRAFFIC_MANAGER_PORT=8000
CARLA_STARTUP_TIMEOUT_SECONDS=180
CARLA_MAP_LOAD_TIMEOUT_SECONDS=300
